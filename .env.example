# Connexion PostgreSQL (locale ou Supabase).
# Supabase : bouton « Connect » du projet, chaîne « Session pooler » (port 5432).
DATABASE_URL="postgresql://postgres:Elhadj19@@localhost:5432/rayon"

# Optionnel : URL utilisée par les commandes Prisma (migrations) à la place de
# DATABASE_URL. Avec un pooler en mode transaction (port 6543) dans
# DATABASE_URL, mettre ici la chaîne « Session pooler » (port 3306).
# DIRECT_URL=""

# Secret de signature des sessions : aléatoire, 32 octets minimum, jamais versionné.
# Exemple : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=r7uWdpaA+LD1R+jC8fTg+AfaUjU+8DcGwqYjahwAF2g=

# Port d'écoute de l'API.
PORT=5000

# Adresse du site web (frontend), sans « / » final : seule origine autorisée à
# utiliser le cookie de session, et cible des redirections vers /login.
FRONTEND_URL="http://localhost:5173"

# Optionnel : autres origines de navigateur autorisées, séparées par des
# virgules (ex : l'aperçu web de l'application mobile, http://localhost:8081).
# CORS_ORIGINS=""

# Optionnel : pour tester, base de données dont le nom se termine par _test.
# Par défaut : la base de DATABASE_URL suffixée par _test.
# TEST_DATABASE_URL=""

# Optionnel, cookie de session du site :
# - COOKIE_SECURE : "true" pour l'exiger en HTTPS (automatique en production) ;
# - COOKIE_SAMESITE : "lax" (défaut), "strict", ou "none" si le site et l'API
#   sont sur deux domaines sans lien (préférer deux sous-domaines du même domaine).
# COOKIE_SECURE=""
# COOKIE_SAMESITE=""
