# Copier ce fichier en `.env` puis renseigner les valeurs.

# Base de données de l'application (développement : PostgreSQL local).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rayon
# Optionnel : connexion directe pour les migrations quand DATABASE_URL passe par
# un pooler en mode transaction (Supabase, port 6543).
# DIRECT_URL=

# Secret de signature des sessions (32 octets aléatoires minimum) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

PORT=4000
FRONTEND_URL=http://localhost:5173
# Origines supplémentaires autorisées (séparées par des virgules).
# CORS_ORIGINS=
# Nombre de reverse proxies de confiance devant l'API (0 à 5).
# TRUST_PROXY_HOPS=0

# Clé d'idempotence (en-tête Idempotency-Key) des opérations sensibles.
# Absente ou "false" : période de transition, une requête sans clé est acceptée
# (application mobile déjà installée) et journalisée « idempotency.key_missing ».
# "true" dès que toutes les applications sont à jour : la clé devient obligatoire.
# IDEMPOTENCY_KEY_REQUIRED=false

# ---------------------------------------------------------------------------
# Tests : à placer dans `.env.test` (jamais ici). Base locale et isolée :
#   docker compose -f docker-compose.test.yml up -d
# TEST_DATABASE_URL=postgresql://rayon_test:rayon_test@localhost:55432/rayon_test
