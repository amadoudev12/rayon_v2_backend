// Schéma Prisma de l'application.
// Documentation : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Rôle d'un utilisateur dans son organisation (une seule adhésion par utilisateur).
enum Role {
  OWNER
  ADMIN
  MANAGER
  SELLER
  STOCK_MANAGER
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_CANCELLATION
  ADJUSTMENT
  INITIAL
  INVENTORY_ADJUSTMENT
  LOSS
  LOSS_CANCELLATION
  SALE_RETURN
  PURCHASE_CANCELLATION
}

/// État d'un abonnement SaaS.
enum SubscriptionStatus {
  /// Période d'essai gratuite.
  TRIAL
  /// Payé, période en cours.
  ACTIVE
  /// Échéance dépassée, paiement attendu (délai de grâce).
  PAST_DUE
  /// Accès suspendu (lecture seule) faute de paiement ou par l'administration.
  SUSPENDED
  /// Résilié à la demande du client.
  CANCELLED
}

enum SubscriptionPaymentStatus {
  /// Transaction créée, paiement non confirmé : aucun effet sur l'abonnement.
  PENDING
  /// Paiement confirmé ET abonnement activé ou prolongé (reçu émis).
  SUCCEEDED
  FAILED
  REFUNDED
  /// Abandonnée par le client ou expirée sans paiement.
  CANCELLED
  /// Paiement reçu mais non applicable automatiquement (montant incorrect,
  /// abonnement suspendu…) : à traiter par l'administration.
  UNDER_REVIEW
}

/// Nature d'une annulation de vente.
enum CancellationKind {
  /// L'argent encaissé doit être rendu : une obligation de remboursement est créée.
  REFUND
  /// Erreur de saisie le jour même : les paiements n'ont jamais été reçus et sont annulés.
  ENTRY_ERROR
  /// Annulation antérieure à la traçabilité des remboursements (reprise de données).
  LEGACY
}

/// Canal par lequel un accord juridique a été recueilli.
enum LegalAcceptanceSource {
  REGISTRATION
  WEB
  MOBILE
}

enum InventoryStatus {
  DRAFT
  IN_PROGRESS
  VALIDATED
  CANCELLED
}

enum InventorySelectionType {
  ALL
  CATEGORY
  MANUAL
}

enum LossStatus {
  ACTIVE
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  CREDIT
  OTHER
}

enum PurchaseStatus {
  RECEIVED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PARTIALLY_REFUNDED
  COMPLETED
}

enum ExpenseStatus {
  ACTIVE
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identité et organisations
// ---------------------------------------------------------------------------

model Utilisateur {
  id             Int     @id @default(autoincrement())
  prenom         String
  nom            String
  /// Identifiants de connexion : email ou téléphone, au moins l'un des deux
  /// (contrainte CHECK en base). Le téléphone est stocké au format
  /// international normalisé, ex : +221771234567 (voir lib/auth/identifier).
  email          String? @unique
  telephone      String? @unique
  motDePasseHash String

  /// Gestionnaire de la plateforme SaaS. Rôle global, distinct du rôle
  /// d'un membre dans une organisation : un super administrateur n'a jamais
  /// d'adhésion (`Membre`) et n'accède qu'à l'espace /admin.
  superAdmin            Boolean   @default(false)
  /// Compte désactivé par le super administrateur : connexion refusée.
  actif                 Boolean   @default(true)
  /// Dernière requête authentifiée (mise à jour au plus toutes les 15 minutes).
  derniereActiviteLe    DateTime?
  /// Vrai après une réinitialisation par un responsable : le mot de passe
  /// temporaire doit être changé avant toute autre opération.
  doitChangerMotDePasse Boolean   @default(false)
  motDePasseModifieLe   DateTime?

  membre                   Membre?
  journauxAudit            JournalAudit[]
  ventes                   Vente[]                  @relation("VenteVendeur")
  achats                   Achat[]                  @relation("AchatCreePar")
  achatsAnnules            Achat[]                  @relation("AchatAnnulation")
  paiementsFournisseur     PaiementFournisseur[]
  depenses                 Depense[]                @relation("DepenseCreePar")
  mouvementsStock          MouvementStock[]
  paiementsVente           PaiementVente[]
  ventesAnnulees           Vente[]                  @relation("VenteAnnulation")
  demandesRemboursement    RemboursementVente[]     @relation("RemboursementDemandeur")
  versementsRemboursement  VersementRemboursement[] @relation("RemboursementVersePar")
  depensesAnnulees         Depense[]                @relation("DepenseAnnulation")
  devis                    Devis[]                  @relation("DevisCreePar")
  inventairesCrees         Inventaire[]             @relation("InventaireCreateur")
  inventairesValides       Inventaire[]             @relation("InventaireValidateur")
  inventairesAnnules       Inventaire[]             @relation("InventaireAnnulateur")
  lignesInventaireComptees LigneInventaire[]        @relation("LigneInventaireCompteur")
  pertesDeclarees          PerteStock[]             @relation("PerteDeclarant")
  pertesAnnulees           PerteStock[]             @relation("PerteAnnulateur")
  retoursVente             RetourVente[]            @relation("RetourCreePar")
  paiementsAnnules         PaiementVente[]          @relation("PaiementAnnulation")
  sessions                 SessionUtilisateur[]
  ventesEnAttente          VenteEnAttente[]         @relation("VenteEnAttenteCreePar")
  evenementsSecurite       JournalSecurite[]
  historiqueAbonnements    HistoriqueAbonnement[]   @relation("HistoriqueAbonnementAuteur")
  paiementsAbonnementCrees PaiementAbonnement[]     @relation("PaiementAbonnementCreePar")
  evenementsPaiement       EvenementPaiement[]
  notifications            Notification[]
  interventionsAdmin       JournalAdministration[]
  acceptationsJuridiques   AcceptationJuridique[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt
}

/// Preuve d'acceptation des CGU et de la Politique de confidentialité.
/// AJOUT SEUL (trigger en base) : une nouvelle acceptation n'écrase jamais
/// les précédentes. Ni adresse IP ni User-Agent : inutiles à cette preuve.
/// Textes et versions : src/legal/registry.ts.
model AcceptationJuridique {
  id             Int                   @id @default(autoincrement())
  userId         Int
  utilisateur    Utilisateur           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime              @default(now())
  source         LegalAcceptanceSource

  @@unique([userId, termsVersion, privacyVersion])
}

/// Un client SaaS (tenant). Toutes les données métier sont rattachées à une
/// Organisation et ne doivent jamais fuiter d'une organisation à l'autre.
model Organisation {
  id                  Int     @id @default(autoincrement())
  nom                 String
  slug                String  @unique
  devise              String  @default("XOF")
  /// Fuseau IANA utilisé pour délimiter les journées et périodes commerciales.
  fuseauHoraire       String  @default("Africa/Dakar")
  /// Faux quand le super administrateur a suspendu l'organisation : ses
  /// membres ne peuvent plus utiliser l'application (données conservées).
  actif               Boolean @default(true)
  /// Pays de l'organisation (code ISO 3166-1 alpha-2, ex : CI, SN). Null :
  /// inconnu (organisations créées avant ce champ).
  pays                String?
  /// Remise maximale (en % du prix catalogue) accordée par un vendeur.
  remiseMaxVendeurPct Int     @default(10)
  /// Remise maximale accordée par un gérant. Propriétaire et administrateur : sans limite.
  remiseMaxGerantPct  Int     @default(30)

  membres               Membre[]
  boutiques             Boutique[]
  categories            Categorie[]
  produits              Produit[]
  clients               Client[]
  fournisseurs          Fournisseur[]
  ventes                Vente[]
  achats                Achat[]
  depenses              Depense[]
  devis                 Devis[]
  journauxAudit         JournalAudit[]
  inventaires           Inventaire[]
  pertesStock           PerteStock[]
  seuilsStock           SeuilStockBoutique[]
  retoursVente          RetourVente[]
  abonnement            Abonnement?
  ventesEnAttente       VenteEnAttente[]
  historiqueAbonnements HistoriqueAbonnement[]
  paiementsAbonnement   PaiementAbonnement[]
  recusAbonnement       RecuAbonnement[]
  notifications         Notification[]
  journalAdministration JournalAdministration[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt
}

/// Relie exactement un Utilisateur à exactement une Organisation, avec un rôle.
/// Un utilisateur n'appartient qu'à une seule organisation (choix volontairement
/// simple) ; l'isolation est garantie en filtrant chaque requête sur `organisationId`.
model Membre {
  id   Int  @id @default(autoincrement())
  role Role @default(SELLER)

  utilisateurId Int         @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  // Si renseigné, le membre est limité à une seule boutique. Null signifie
  // qu'il a accès à toutes les boutiques de l'organisation.
  boutiqueId Int?
  boutique   Boutique? @relation(fields: [boutiqueId], references: [id], onDelete: SetNull)

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([organisationId])
}

/// Un point de vente physique appartenant à une organisation.
model Boutique {
  id        Int     @id @default(autoincrement())
  nom       String
  adresse   String?
  telephone String?
  parDefaut Boolean @default(false)

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  membres         Membre[]
  stocks          Stock[]
  mouvementsStock MouvementStock[]
  ventes          Vente[]
  achats          Achat[]
  depenses        Depense[]
  devis           Devis[]
  inventaires     Inventaire[]
  pertesStock     PerteStock[]
  seuilsStock     SeuilStockBoutique[]
  retoursVente    RetourVente[]
  ventesEnAttente VenteEnAttente[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Catalogue et stock
// ---------------------------------------------------------------------------

model Categorie {
  id          Int     @id @default(autoincrement())
  nom         String
  description String?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  produits    Produit[]
  inventaires Inventaire[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@unique([organisationId, nom])
}

model Produit {
  id          Int     @id @default(autoincrement())
  nom         String
  description String?
  reference   String?
  codeBarres  String?
  unite       String  @default("unité")
  prixAchat   Decimal @db.Decimal(12, 2)
  prixVente   Decimal @db.Decimal(12, 2)
  seuilAlerte Int     @default(5)
  actif       Boolean @default(true)

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  categorieId Int?
  categorie   Categorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)

  stocks           Stock[]
  mouvementsStock  MouvementStock[]
  lignesVente      LigneVente[]
  lignesAchat      LigneAchat[]
  lignesDevis      LigneDevis[]
  lignesInventaire LigneInventaire[]
  pertesStock      PerteStock[]
  seuilsStock      SeuilStockBoutique[]
  lignesRetour     LigneRetourVente[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@unique([organisationId, reference])
  @@index([organisationId, categorieId])
  @@index([organisationId, actif])
}

/// Quantité disponible d'un produit dans une boutique donnée.
model Stock {
  id       Int @id @default(autoincrement())
  quantite Int @default(0)

  boutiqueId Int
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  produitId Int
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  modifieLe DateTime @updatedAt

  @@unique([boutiqueId, produitId])
  @@index([produitId])
}

model SeuilStockBoutique {
  id             Int          @id @default(autoincrement())
  seuilAlerte    Int
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  boutiqueId     Int
  boutique       Boutique     @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  produitId      Int
  produit        Produit      @relation(fields: [produitId], references: [id], onDelete: Cascade)
  modifieLe      DateTime     @updatedAt

  @@unique([boutiqueId, produitId])
  @@index([produitId])
}

model Inventaire {
  id              Int                    @id @default(autoincrement())
  reference       String                 @unique
  libelle         String
  statut          InventoryStatus        @default(IN_PROGRESS)
  selectionType   InventorySelectionType
  categorieId     Int?
  categorie       Categorie?             @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  produitIds      Int[]
  demarreLe       DateTime               @default(now())
  valideLe        DateTime?
  annuleLe        DateTime?
  motifAnnulation String?
  organisationId  Int
  organisation    Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  boutiqueId      Int
  boutique        Boutique               @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  creeParId       Int
  creePar         Utilisateur            @relation("InventaireCreateur", fields: [creeParId], references: [id], onDelete: Restrict)
  valideParId     Int?
  validePar       Utilisateur?           @relation("InventaireValidateur", fields: [valideParId], references: [id], onDelete: SetNull)
  annuleParId     Int?
  annulePar       Utilisateur?           @relation("InventaireAnnulateur", fields: [annuleParId], references: [id], onDelete: SetNull)
  lignes          LigneInventaire[]
  creeLe          DateTime               @default(now())
  modifieLe       DateTime               @updatedAt

  @@index([organisationId, boutiqueId, creeLe])
  @@index([organisationId, statut])
}

model LigneInventaire {
  id                Int              @id @default(autoincrement())
  produitNom        String
  produitReference  String?
  categorieNom      String?
  quantiteTheorique Int
  quantiteComptee   Int?
  coutUnitaire      Decimal          @db.Decimal(12, 2)
  compteLe          DateTime?
  version           Int              @default(0)
  inventaireId      Int
  inventaire        Inventaire       @relation(fields: [inventaireId], references: [id], onDelete: Cascade)
  produitId         Int
  produit           Produit          @relation(fields: [produitId], references: [id], onDelete: Restrict)
  compteParId       Int?
  comptePar         Utilisateur?     @relation("LigneInventaireCompteur", fields: [compteParId], references: [id], onDelete: SetNull)
  mouvements        MouvementStock[]

  @@unique([inventaireId, produitId])
}

model PerteStock {
  id                   Int              @id @default(autoincrement())
  reference            String           @unique
  quantite             Int
  motif                String
  description          String?
  coutUnitaire         Decimal          @db.Decimal(12, 2)
  statut               LossStatus       @default(ACTIVE)
  cleIdempotence       String
  empreinteIdempotence String
  annuleLe             DateTime?
  motifAnnulation      String?
  organisationId       Int
  organisation         Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  boutiqueId           Int
  boutique             Boutique         @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  produitId            Int
  produit              Produit          @relation(fields: [produitId], references: [id], onDelete: Restrict)
  declareParId         Int
  declarePar           Utilisateur      @relation("PerteDeclarant", fields: [declareParId], references: [id], onDelete: Restrict)
  annuleParId          Int?
  annulePar            Utilisateur?     @relation("PerteAnnulateur", fields: [annuleParId], references: [id], onDelete: SetNull)
  mouvements           MouvementStock[]
  creeLe               DateTime         @default(now())

  @@unique([organisationId, cleIdempotence])
  @@index([organisationId, boutiqueId, creeLe])
  @@index([produitId, statut, creeLe])
}

/// Historique immuable de chaque variation de stock, pour la traçabilité et les audits.
model MouvementStock {
  id                Int               @id @default(autoincrement())
  type              StockMovementType
  variationQuantite Int
  note              String?
  quantiteAvant     Int?
  quantiteApres     Int?
  coutUnitaire      Decimal?          @db.Decimal(12, 2)
  sourceReference   String?
  /// Clé d'idempotence d'un ajustement manuel (NULL pour les autres mouvements).
  cleIdempotence    String?

  boutiqueId Int
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  produitId Int
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Restrict)

  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  venteId Int?
  vente   Vente? @relation(fields: [venteId], references: [id], onDelete: SetNull)

  achatId Int?
  achat   Achat? @relation(fields: [achatId], references: [id], onDelete: SetNull)

  ligneInventaireId Int?
  ligneInventaire   LigneInventaire? @relation(fields: [ligneInventaireId], references: [id], onDelete: SetNull)
  perteStockId      Int?
  perteStock        PerteStock?      @relation(fields: [perteStockId], references: [id], onDelete: SetNull)
  retourVenteId     Int?
  retourVente       RetourVente?     @relation(fields: [retourVenteId], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())

  @@unique([boutiqueId, cleIdempotence])
  @@index([boutiqueId, produitId, creeLe])
  @@index([perteStockId])
  @@index([retourVenteId])
  @@index([ligneInventaireId])
}

// ---------------------------------------------------------------------------
// Tiers
// ---------------------------------------------------------------------------

model Client {
  id        Int     @id @default(autoincrement())
  nom       String
  telephone String?
  email     String?
  adresse   String?

  /// Client archivé : masqué des listes et des nouvelles ventes, historique conservé.
  archive   Boolean   @default(false)
  archiveLe DateTime?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  ventes          Vente[]
  devis           Devis[]
  ventesEnAttente VenteEnAttente[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([organisationId, archive])
}

model Fournisseur {
  id        Int     @id @default(autoincrement())
  nom       String
  telephone String?
  email     String?
  adresse   String?

  /// Fournisseur archivé : masqué des listes et des nouveaux achats, historique conservé.
  archive   Boolean   @default(false)
  archiveLe DateTime?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  achats Achat[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([organisationId, archive])
}

// ---------------------------------------------------------------------------
// Ventes
// ---------------------------------------------------------------------------

model Vente {
  id                 Int           @id @default(autoincrement())
  statut             SaleStatus    @default(COMPLETED)
  modePaiement       PaymentMethod @default(CASH)
  sousTotal          Decimal       @db.Decimal(12, 2)
  remise             Decimal       @default(0) @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  /// Somme des paiements reçus et non annulés (`paiements`), tenue à jour
  /// dans la même transaction que chaque paiement.
  montantPaye        Decimal       @db.Decimal(12, 2)
  /// Valeur des retours (avoirs), remise de la vente déduite.
  montantRetourne    Decimal       @default(0) @db.Decimal(12, 2)
  /// Somme des remboursements dus au client (demandes), versés ou non.
  montantARembourser Decimal       @default(0) @db.Decimal(12, 2)
  /// Solde dû par le client : total − retours − (payé − remboursements dus).
  /// Toujours 0 pour une vente annulée. Maintenu dans chaque transaction.
  resteAPayer        Decimal       @default(0) @db.Decimal(12, 2)
  note               String?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  boutiqueId Int
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  vendeurId Int
  vendeur   Utilisateur @relation("VenteVendeur", fields: [vendeurId], references: [id])

  lignes          LigneVente[]
  paiements       PaiementVente[]
  remboursements  RemboursementVente[]
  retours         RetourVente[]
  mouvementsStock MouvementStock[]
  devis           Devis?

  creeLe               DateTime          @default(now())
  annuleLe             DateTime?
  motifAnnulation      String?
  annuleParId          Int?
  annulePar            Utilisateur?      @relation("VenteAnnulation", fields: [annuleParId], references: [id], onDelete: SetNull)
  typeAnnulation       CancellationKind?
  /// Clé d'idempotence de la requête d'annulation (rejeu sans effet).
  cleAnnulation        String?
  cleIdempotence       String?
  empreinteIdempotence String?
  /// Vente à crédit : date à laquelle le client s'est engagé à solder.
  dateEcheance         DateTime?

  @@unique([organisationId, cleIdempotence])
  @@index([organisationId, boutiqueId, creeLe])
  @@index([organisationId, boutiqueId, dateEcheance])
  @@index([clientId])
  @@index([organisationId, boutiqueId, resteAPayer])
  // Statistiques de la plateforme (toutes organisations confondues).
  @@index([creeLe])
}

/// Prix et coût sont figés au moment de la vente : la marge d'une ancienne
/// vente ne change jamais quand le prix d'achat du produit évolue.
/// Coût total = coutUnitaire × quantite ; marge = sousTotal − coût total.
model LigneVente {
  id           Int     @id @default(autoincrement())
  quantite     Int
  prixUnitaire Decimal @db.Decimal(12, 2)
  coutUnitaire Decimal @db.Decimal(12, 2)
  sousTotal    Decimal @db.Decimal(12, 2)

  venteId Int
  vente   Vente @relation(fields: [venteId], references: [id], onDelete: Cascade)

  produitId Int
  produit   Produit @relation(fields: [produitId], references: [id])

  /// Quantité déjà retournée (somme des lignes de retour).
  quantiteRetournee Int                @default(0)
  retours           LigneRetourVente[]

  @@unique([venteId, produitId])
}

/// Un versement d'un client sur une vente : le paiement initial (comptant ou
/// premier versement d'un crédit) puis chaque remboursement ultérieur. Un
/// paiement n'est jamais une nouvelle vente : il ne touche que l'encaissé.
model PaiementVente {
  id             Int            @id @default(autoincrement())
  montant        Decimal        @db.Decimal(12, 2)
  date           DateTime       @default(now())
  /// Null pour les versements historiques dont le mode réel n'est pas connu.
  modePaiement   PaymentMethod?
  cleIdempotence String?

  venteId Int
  vente   Vente @relation(fields: [venteId], references: [id], onDelete: Cascade)

  utilisateurId Int?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  /// Paiement annulé (erreur de saisie : argent jamais reçu). Il reste dans
  /// l'historique mais ne compte plus dans l'encaissé.
  annuleLe        DateTime?
  annuleParId     Int?
  annulePar       Utilisateur? @relation("PaiementAnnulation", fields: [annuleParId], references: [id], onDelete: SetNull)
  motifAnnulation String?

  @@unique([venteId, cleIdempotence])
  @@index([venteId])
  @@index([date])
}

/// Demande de remboursement liée à une vente. Une annulation payée crée une
/// demande PENDING ; seuls ses versements confirment l'argent réellement rendu.
model RemboursementVente {
  id             Int          @id @default(autoincrement())
  montant        Decimal      @db.Decimal(12, 2)
  statut         RefundStatus @default(PENDING)
  motif          String
  cleIdempotence String

  venteId Int
  vente   Vente @relation(fields: [venteId], references: [id], onDelete: Restrict)

  demandeParId Int
  demandePar   Utilisateur @relation("RemboursementDemandeur", fields: [demandeParId], references: [id], onDelete: Restrict)

  /// Retour de produits à l'origine du remboursement ; null pour une annulation.
  retourVenteId Int?
  retourVente   RetourVente? @relation(fields: [retourVenteId], references: [id], onDelete: Restrict)

  versements VersementRemboursement[]
  creeLe     DateTime                 @default(now())
  modifieLe  DateTime                 @updatedAt

  @@unique([venteId, cleIdempotence])
  @@index([venteId, statut])
  @@index([retourVenteId])
}

/// Retour de produits sur une vente terminée. L'avoir (`montant`) réduit le
/// chiffre d'affaires et le solde du client ; ce que le client a payé en trop
/// devient une obligation de remboursement. Les produits revendables sont
/// remis en stock, les autres sont comptés en pertes.
model RetourVente {
  id                   Int     @id @default(autoincrement())
  /// Avoir total, remise de la vente répartie au prorata des lignes.
  montant              Decimal @db.Decimal(12, 2)
  /// Coût d'achat figé des articles retournés.
  coutTotal            Decimal @db.Decimal(12, 2)
  motif                String
  cleIdempotence       String
  empreinteIdempotence String

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  boutiqueId     Int
  boutique       Boutique     @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  venteId        Int
  vente          Vente        @relation(fields: [venteId], references: [id], onDelete: Restrict)
  creeParId      Int
  creePar        Utilisateur  @relation("RetourCreePar", fields: [creeParId], references: [id], onDelete: Restrict)

  lignes          LigneRetourVente[]
  remboursements  RemboursementVente[]
  mouvementsStock MouvementStock[]

  creeLe DateTime @default(now())

  @@unique([venteId, cleIdempotence])
  @@index([organisationId, boutiqueId, creeLe])
}

model LigneRetourVente {
  id            Int     @id @default(autoincrement())
  quantite      Int
  /// Avoir de la ligne (prix net après remise).
  montant       Decimal @db.Decimal(12, 2)
  /// Coût unitaire figé sur la ligne de vente.
  coutUnitaire  Decimal @db.Decimal(12, 2)
  /// Vrai : article revendable remis en stock. Faux : compté en pertes.
  remiseEnStock Boolean

  retourVenteId Int
  retourVente   RetourVente @relation(fields: [retourVenteId], references: [id], onDelete: Cascade)
  ligneVenteId  Int
  ligneVente    LigneVente  @relation(fields: [ligneVenteId], references: [id], onDelete: Restrict)
  produitId     Int
  produit       Produit     @relation(fields: [produitId], references: [id], onDelete: Restrict)

  @@index([retourVenteId])
  @@index([ligneVenteId])
}

/// Versement effectif d'un remboursement. Les demandes peuvent être réglées
/// en plusieurs fois ; chaque sortie conserve son mode, sa date et son auteur.
model VersementRemboursement {
  id             Int           @id @default(autoincrement())
  montant        Decimal       @db.Decimal(12, 2)
  modePaiement   PaymentMethod
  date           DateTime      @default(now())
  cleIdempotence String

  remboursementVenteId Int
  remboursementVente   RemboursementVente @relation(fields: [remboursementVenteId], references: [id], onDelete: Restrict)

  utilisateurId Int
  utilisateur   Utilisateur @relation("RemboursementVersePar", fields: [utilisateurId], references: [id], onDelete: Restrict)

  @@unique([remboursementVenteId, cleIdempotence])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Devis
// ---------------------------------------------------------------------------

/// Proposition de prix remise à un client. Un devis ne touche ni au stock, ni
/// au chiffre d'affaires, ni aux créances.
model Devis {
  id             Int       @id @default(autoincrement())
  sousTotal      Decimal   @db.Decimal(12, 2)
  remise         Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  /// Nom saisi librement quand le client n'est pas enregistré.
  nomClient      String?
  valableJusquAu DateTime?
  note           String?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  boutiqueId Int
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  creeParId Int
  creePar   Utilisateur @relation("DevisCreePar", fields: [creeParId], references: [id])

  lignes LigneDevis[]

  /// Vente issue de ce devis. Un devis ne peut être transformé qu'une fois ;
  /// le lien est retiré si la vente est annulée.
  venteId Int?   @unique
  vente   Vente? @relation(fields: [venteId], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())

  @@index([organisationId, boutiqueId, creeLe])
}

model LigneDevis {
  id           Int     @id @default(autoincrement())
  /// Nom du produit au moment du devis : le devis reste lisible si le produit est supprimé.
  designation  String
  quantite     Int
  prixUnitaire Decimal @db.Decimal(12, 2)
  sousTotal    Decimal @db.Decimal(12, 2)

  devisId Int
  devis   Devis @relation(fields: [devisId], references: [id], onDelete: Cascade)

  produitId Int?
  produit   Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull)

  @@index([devisId])
}

// ---------------------------------------------------------------------------
// Achats
// ---------------------------------------------------------------------------

model Achat {
  id                   Int            @id @default(autoincrement())
  statut               PurchaseStatus @default(RECEIVED)
  total                Decimal        @db.Decimal(12, 2)
  /// Somme des paiements au fournisseur (`paiements`), tenue à jour dans la
  /// même transaction que chaque paiement.
  montantPaye          Decimal        @db.Decimal(12, 2)
  /// Reste dû au fournisseur : total − payé ; 0 pour un achat annulé.
  resteAPayer          Decimal        @default(0) @db.Decimal(12, 2)
  note                 String?
  /// Clé d'idempotence de la création : un achat rejoué n'est enregistré qu'une fois.
  cleIdempotence       String?
  empreinteIdempotence String?
  annuleLe             DateTime?
  annuleParId          Int?
  annulePar            Utilisateur?   @relation("AchatAnnulation", fields: [annuleParId], references: [id], onDelete: SetNull)
  motifAnnulation      String?
  cleAnnulation        String?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  boutiqueId Int
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  fournisseurId Int?
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)

  creeParId Int
  creePar   Utilisateur @relation("AchatCreePar", fields: [creeParId], references: [id])

  lignes          LigneAchat[]
  mouvementsStock MouvementStock[]
  paiements       PaiementFournisseur[]

  creeLe DateTime @default(now())

  @@unique([organisationId, cleIdempotence])
  @@index([organisationId, boutiqueId, creeLe])
  @@index([organisationId, boutiqueId, resteAPayer])
}

/// Un versement au fournisseur sur un achat (paiement initial puis règlements).
model PaiementFournisseur {
  id             Int            @id @default(autoincrement())
  montant        Decimal        @db.Decimal(12, 2)
  /// Null pour les paiements historiques dont le mode n'est pas connu.
  modePaiement   PaymentMethod?
  date           DateTime       @default(now())
  cleIdempotence String?

  achatId       Int
  achat         Achat        @relation(fields: [achatId], references: [id], onDelete: Restrict)
  utilisateurId Int?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@unique([achatId, cleIdempotence])
  @@index([date])
}

model LigneAchat {
  id           Int     @id @default(autoincrement())
  quantite     Int
  coutUnitaire Decimal @db.Decimal(12, 2)
  sousTotal    Decimal @db.Decimal(12, 2)

  achatId Int
  achat   Achat @relation(fields: [achatId], references: [id], onDelete: Cascade)

  produitId Int
  produit   Produit @relation(fields: [produitId], references: [id])

  @@unique([achatId, produitId])
}

// ---------------------------------------------------------------------------
// Finances et audit
// ---------------------------------------------------------------------------

model Depense {
  id              Int           @id @default(autoincrement())
  categorie       String
  libelle         String
  montant         Decimal       @db.Decimal(12, 2)
  note            String?
  date            DateTime      @default(now())
  statut          ExpenseStatus @default(ACTIVE)
  annuleLe        DateTime?
  annuleParId     Int?
  annulePar       Utilisateur?  @relation("DepenseAnnulation", fields: [annuleParId], references: [id], onDelete: SetNull)
  motifAnnulation String?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  boutiqueId Int?
  boutique   Boutique? @relation(fields: [boutiqueId], references: [id], onDelete: SetNull)

  creeParId Int
  creePar   Utilisateur @relation("DepenseCreePar", fields: [creeParId], references: [id])

  creeLe DateTime @default(now())

  @@index([organisationId, date])
}

/// Journal en ajout seul des actions sensibles, rattaché à une organisation.
model JournalAudit {
  id          Int    @id @default(autoincrement())
  action      String
  entite      String
  entiteId    Int?
  metadonnees Json?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  utilisateurId Int?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())

  @@index([organisationId, creeLe])
  @@index([creeLe])
}

// ---------------------------------------------------------------------------
// Sécurité : sessions, journal de sécurité, limitation de débit
// ---------------------------------------------------------------------------

/// Session ouverte par une connexion (site ou mobile). Le jeton signé porte
/// l'identifiant de session : une session révoquée ou expirée est refusée dès
/// la requête suivante (déconnexion réelle, changement de mot de passe…).
model SessionUtilisateur {
  id                  String    @id
  audience            String
  creeLe              DateTime  @default(now())
  expireLe            DateTime
  revoqueLe           DateTime?
  motifRevocation     String?
  derniereUtilisation DateTime  @default(now())
  adresseIp           String?
  agentUtilisateur    String?

  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, revoqueLe])
}

/// Événements de sécurité (connexions, mots de passe, sessions), y compris
/// pour les comptes sans organisation. Ajout seul.
model JournalSecurite {
  id          Int      @id @default(autoincrement())
  evenement   String
  identifiant String?
  adresseIp   String?
  metadonnees Json?
  creeLe      DateTime @default(now())

  utilisateurId Int?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([utilisateurId, creeLe])
  @@index([evenement, creeLe])
}

/// Compteurs de limitation de débit partagés par toutes les instances de l'API.
model CompteurLimite {
  cle          String    @id
  compteur     Int
  fenetreDebut DateTime
  bloqueJusqua DateTime?
  rejets       Int       @default(0)
  modifieLe    DateTime  @default(now())

  @@index([modifieLe])
}

// ---------------------------------------------------------------------------
// Abonnements SaaS (fondations : aucun prestataire de paiement intégré)
// ---------------------------------------------------------------------------

/// Abonnement d'une organisation. Absent : organisation non soumise aux
/// abonnements (comptes historiques, tant que la facturation n'est pas activée).
/// Les prix, quotas et droits viennent du catalogue (services/billing/plans).
model Abonnement {
  id                    Int                 @id @default(autoincrement())
  /// Code du forfait : STARTER, BUSINESS ou PREMIUM (codes antérieurs au
  /// catalogue conservés tels quels, traités comme PREMIUM).
  plan                  String
  statut                SubscriptionStatus  @default(TRIAL)
  /// Début de l'essai gratuit. Renseigné : l'essai unique a été consommé.
  essaiDebutLe          DateTime?
  essaiFinLe            DateTime?
  periodeDebut          DateTime
  periodeFin            DateTime
  annuleLe              DateTime?
  /// Prestataire de paiement retenu (ex : "wave", "orange_money", "cinetpay").
  fournisseur           String?
  /// Identifiant de l'abonnement ou du client chez le prestataire.
  referenceExterne      String?
  /// Rétrogradation programmée : forfait appliqué à `forfaitProgrammeLe`.
  forfaitProgramme      String?
  forfaitProgrammeLe    DateTime?
  /// Suspension administrative (statut SUSPENDED) : date et motif.
  suspenduLe            DateTime?
  motifSuspension       String?
  /// Statut rétabli à la réactivation (essai ou période payée).
  statutAvantSuspension SubscriptionStatus?

  organisationId Int                    @unique
  organisation   Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  paiements      PaiementAbonnement[]
  historique     HistoriqueAbonnement[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt
}

/// Transaction de paiement d'abonnement. Créée par le serveur (montant
/// calculé par le backend, référence interne unique) AVANT le paiement ; elle
/// n'a d'effet sur l'abonnement qu'une fois confirmée. Jamais supprimée :
/// l'historique financier reste complet. L'unicité (fournisseur, référence
/// externe) rend le traitement des confirmations idempotent.
model PaiementAbonnement {
  id               Int                       @id @default(autoincrement())
  /// Montant DÛ, calculé par le serveur.
  montant          Decimal                   @db.Decimal(12, 2)
  devise           String
  statut           SubscriptionPaymentStatus @default(PENDING)
  /// MANUEL (Mobile Money hors ligne confirmé par l'administration) ou
  /// identifiant du prestataire.
  fournisseur      String
  /// Référence de la transaction chez le prestataire (null tant qu'inconnue).
  referenceExterne String?
  /// Référence interne unique, communiquée au client et au prestataire.
  referenceInterne String?                   @unique
  /// Achat demandé : PERIOD (souscription, renouvellement) ou UPGRADE.
  typeAchat        String?
  forfait          String?
  dureeMois        Int?
  /// Période couverte : estimée à la création, définitive à l'activation.
  periodeDebut     DateTime
  periodeFin       DateTime
  /// Montant effectivement reçu, moyen de paiement et date de confirmation.
  montantRecu      Decimal?                  @db.Decimal(12, 2)
  moyenPaiement    String?
  paiementRecuLe   DateTime?
  /// Date d'activation de l'abonnement (statut SUCCEEDED).
  payeLe           DateTime?
  /// Motif d'échec, d'annulation ou de mise en vérification.
  motif            String?
  metadonnees      Json?

  organisationId Int?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  abonnementId   Int?
  abonnement     Abonnement?   @relation(fields: [abonnementId], references: [id], onDelete: Restrict)
  creeParId      Int?
  creePar        Utilisateur?  @relation("PaiementAbonnementCreePar", fields: [creeParId], references: [id], onDelete: SetNull)

  recu       RecuAbonnement?
  evenements EvenementPaiement[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @default(now()) @updatedAt

  @@unique([fournisseur, referenceExterne])
  @@index([abonnementId, creeLe])
  @@index([organisationId, creeLe])
  @@index([statut, creeLe])
}

/// Reçu numérique d'un paiement confirmé : un seul par paiement, jamais
/// modifié. Les informations sont figées au moment de l'émission.
model RecuAbonnement {
  id                   Int      @id @default(autoincrement())
  numero               String   @unique
  nomOrganisation      String
  forfait              String
  typeAchat            String
  dureeMois            Int?
  montant              Decimal  @db.Decimal(12, 2)
  devise               String
  moyenPaiement        String?
  referenceTransaction String
  referenceExterne     String?
  confirmeLe           DateTime
  periodeDebut         DateTime
  periodeFin           DateTime

  organisationId Int
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  paiementId     Int                @unique
  paiement       PaiementAbonnement @relation(fields: [paiementId], references: [id], onDelete: Restrict)

  emisLe DateTime @default(now())

  @@index([organisationId, emisLe])
}

/// Journal en ajout seul de tout ce qui arrive à une transaction : création,
/// notification du prestataire (signature vérifiée ou rejetée), confirmation
/// manuelle, activation, mise en vérification, rapprochement. L'unicité
/// (fournisseur, identifiant d'événement) écarte les notifications répétées.
model EvenementPaiement {
  id                   Int     @id @default(autoincrement())
  fournisseur          String
  identifiantEvenement String?
  type                 String
  /// RECEIVED, PROCESSED, IGNORED, REJECTED, FAILED.
  statutTraitement     String
  donnees              Json?
  erreur               String?

  paiementId    Int?
  paiement      PaiementAbonnement? @relation(fields: [paiementId], references: [id], onDelete: SetNull)
  effectueParId Int?
  effectuePar   Utilisateur?        @relation(fields: [effectueParId], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())

  @@unique([fournisseur, identifiantEvenement])
  @@index([paiementId, creeLe])
  @@index([creeLe])
}

/// Journal d'audit de l'administration centrale (ajout seul) : chaque
/// intervention manuelle d'un administrateur de Rayon, avec l'ancienne et la
/// nouvelle valeur et le motif. Jamais modifié ni supprimé.
model JournalAdministration {
  id             Int     @id @default(autoincrement())
  /// Ex : subscription.plan_assigned, subscription.extended,
  /// subscription.suspended, payment.confirmed…
  action         String
  entite         String
  entiteId       Int?
  ancienneValeur Json?
  nouvelleValeur Json?
  motif          String?

  adminId        Int
  admin          Utilisateur   @relation(fields: [adminId], references: [id], onDelete: Restrict)
  organisationId Int?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  creeLe DateTime @default(now())

  @@index([creeLe])
  @@index([organisationId, creeLe])
  @@index([adminId, creeLe])
}

/// Notification intégrée à l'application (aucun envoi email ou WhatsApp).
/// `cle` empêche de générer deux fois la même notification.
model Notification {
  id      Int       @id @default(autoincrement())
  type    String
  titre   String
  message String
  /// Page concernée (ex : /abonnement).
  lien    String?
  cle     String
  luLe    DateTime?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  utilisateurId  Int
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  creeLe DateTime @default(now())

  @@unique([organisationId, cle])
  @@index([utilisateurId, luLe, creeLe])
}

/// Historique en ajout seul de chaque changement d'un abonnement (essai,
/// souscription, renouvellement, changement de forfait, intervention).
model HistoriqueAbonnement {
  id                 Int                 @id @default(autoincrement())
  /// Ex : TRIAL_STARTED, SUBSCRIBED, RENEWED, UPGRADED, DOWNGRADE_SCHEDULED,
  /// DOWNGRADE_CANCELLED, PLAN_CHANGED, ADMIN_UPDATED, PAYMENT_RECORDED.
  action             String
  ancienForfait      String?
  nouveauForfait     String?
  ancienStatut       SubscriptionStatus?
  nouveauStatut      SubscriptionStatus?
  anciennePeriodeFin DateTime?
  nouvellePeriodeFin DateTime?
  motif              String?
  metadonnees        Json?

  abonnementId   Int
  abonnement     Abonnement   @relation(fields: [abonnementId], references: [id], onDelete: Restrict)
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  /// Auteur (propriétaire, administrateur central) ; null : système.
  effectueParId  Int?
  effectuePar    Utilisateur? @relation("HistoriqueAbonnementAuteur", fields: [effectueParId], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())

  @@index([abonnementId, creeLe])
  @@index([organisationId, creeLe])
}

// ---------------------------------------------------------------------------
// Ventes en attente (panier « garé » au comptoir)
// ---------------------------------------------------------------------------

/// Panier mis de côté pour servir un autre client, repris plus tard par
/// n'importe quel membre de la boutique. Rien n'est encaissé ni sorti du
/// stock : tout est revérifié à l'encaissement. Expire après 24 h.
model VenteEnAttente {
  id             Int      @id @default(autoincrement())
  libelle        String
  /// Panier : lignes (produit, quantité, prix négocié), client, paiement, remise…
  panier         Json
  nombreArticles Int
  /// Total indicatif au moment de la mise en attente (prix négociés et remise).
  totalEstime    Decimal  @db.Decimal(12, 2)
  expireLe       DateTime

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  boutiqueId     Int
  boutique       Boutique     @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  clientId       Int?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  creeParId      Int
  creePar        Utilisateur  @relation("VenteEnAttenteCreePar", fields: [creeParId], references: [id], onDelete: Cascade)

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@index([organisationId, boutiqueId, expireLe])
}
