// Schéma Prisma de l'application.
// Documentation : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Rôle d'un utilisateur dans son organisation (une seule adhésion par utilisateur).
enum Role {
  OWNER
  ADMIN
  MANAGER
  SELLER
  STOCK_MANAGER
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_CANCELLATION
  ADJUSTMENT
  INITIAL
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  CREDIT
  OTHER
}

enum PurchaseStatus {
  RECEIVED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identité et organisations
// ---------------------------------------------------------------------------

model Utilisateur {
  id             Int      @id @default(autoincrement())
  prenom         String
  nom            String
  /// Identifiants de connexion : email ou téléphone, au moins l'un des deux
  /// (contrainte CHECK en base). Le téléphone est stocké au format
  /// international normalisé, ex : +221771234567 (voir lib/auth/identifier).
  email          String?  @unique
  telephone      String?  @unique
  motDePasseHash String

  /// Gestionnaire de la plateforme SaaS. Rôle global, distinct du rôle
  /// d'un membre dans une organisation : un super administrateur n'a jamais
  /// d'adhésion (`Membre`) et n'accède qu'à l'espace /admin.
  superAdmin         Boolean   @default(false)
  /// Compte désactivé par le super administrateur : connexion refusée.
  actif              Boolean   @default(true)
  /// Dernière requête authentifiée (mise à jour au plus toutes les 15 minutes).
  derniereActiviteLe DateTime?

  membre          Membre?
  journauxAudit   JournalAudit[]
  ventes          Vente[]          @relation("VenteVendeur")
  achats          Achat[]          @relation("AchatCreePar")
  depenses        Depense[]        @relation("DepenseCreePar")
  mouvementsStock MouvementStock[]

  creeLe         DateTime @default(now())
  modifieLe      DateTime @updatedAt
}

/// Un client SaaS (tenant). Toutes les données métier sont rattachées à une
/// Organisation et ne doivent jamais fuiter d'une organisation à l'autre.
model Organisation {
  id        Int      @id @default(autoincrement())
  nom       String
  slug      String   @unique
  devise    String   @default("XOF")
  /// Faux quand le super administrateur a suspendu l'organisation : ses
  /// membres ne peuvent plus utiliser l'application (données conservées).
  actif     Boolean  @default(true)

  membres       Membre[]
  boutiques     Boutique[]
  categories    Categorie[]
  produits      Produit[]
  clients       Client[]
  fournisseurs  Fournisseur[]
  ventes        Vente[]
  achats        Achat[]
  depenses      Depense[]
  journauxAudit JournalAudit[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt
}

/// Relie exactement un Utilisateur à exactement une Organisation, avec un rôle.
/// Un utilisateur n'appartient qu'à une seule organisation (choix volontairement
/// simple) ; l'isolation est garantie en filtrant chaque requête sur `organisationId`.
model Membre {
  id             Int      @id @default(autoincrement())
  role           Role     @default(SELLER)

  utilisateurId  Int      @unique
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  // Si renseigné, le membre est limité à une seule boutique. Null signifie
  // qu'il a accès à toutes les boutiques de l'organisation.
  boutiqueId     Int?
  boutique       Boutique? @relation(fields: [boutiqueId], references: [id], onDelete: SetNull)

  creeLe         DateTime @default(now())
  modifieLe      DateTime @updatedAt

  @@index([organisationId])
}

/// Un point de vente physique appartenant à une organisation.
model Boutique {
  id             Int      @id @default(autoincrement())
  nom            String
  adresse        String?
  telephone      String?
  parDefaut      Boolean  @default(false)

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  membres         Membre[]
  stocks          Stock[]
  mouvementsStock MouvementStock[]
  ventes          Vente[]
  achats          Achat[]
  depenses        Depense[]

  creeLe         DateTime @default(now())
  modifieLe      DateTime @updatedAt

  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Catalogue et stock
// ---------------------------------------------------------------------------

model Categorie {
  id             Int      @id @default(autoincrement())
  nom            String
  description    String?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  produits       Produit[]

  creeLe         DateTime @default(now())
  modifieLe      DateTime @updatedAt

  @@unique([organisationId, nom])
}

model Produit {
  id             Int      @id @default(autoincrement())
  nom            String
  description    String?
  reference      String?
  codeBarres     String?
  unite          String   @default("unité")
  prixAchat      Decimal  @db.Decimal(12, 2)
  prixVente      Decimal  @db.Decimal(12, 2)
  seuilAlerte    Int      @default(5)
  actif          Boolean  @default(true)

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  categorieId    Int?
  categorie      Categorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)

  stocks          Stock[]
  mouvementsStock MouvementStock[]
  lignesVente     LigneVente[]
  lignesAchat     LigneAchat[]

  creeLe         DateTime @default(now())
  modifieLe      DateTime @updatedAt

  @@unique([organisationId, reference])
  @@index([organisationId, categorieId])
  @@index([organisationId, actif])
}

/// Quantité disponible d'un produit dans une boutique donnée.
model Stock {
  id         Int      @id @default(autoincrement())
  quantite   Int      @default(0)

  boutiqueId Int
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  produitId  Int
  produit    Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)

  modifieLe  DateTime @updatedAt

  @@unique([boutiqueId, produitId])
  @@index([produitId])
}

/// Historique immuable de chaque variation de stock, pour la traçabilité et les audits.
model MouvementStock {
  id                Int               @id @default(autoincrement())
  type              StockMovementType
  variationQuantite Int
  note              String?

  boutiqueId        Int
  boutique          Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  produitId         Int
  produit           Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)

  utilisateurId     Int
  utilisateur       Utilisateur @relation(fields: [utilisateurId], references: [id])

  venteId           Int?
  vente             Vente?   @relation(fields: [venteId], references: [id], onDelete: SetNull)

  achatId           Int?
  achat             Achat?   @relation(fields: [achatId], references: [id], onDelete: SetNull)

  creeLe            DateTime @default(now())

  @@index([boutiqueId, produitId, creeLe])
}

// ---------------------------------------------------------------------------
// Tiers
// ---------------------------------------------------------------------------

model Client {
  id             Int      @id @default(autoincrement())
  nom            String
  telephone      String?
  email          String?
  adresse        String?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  ventes         Vente[]

  creeLe         DateTime @default(now())
  modifieLe      DateTime @updatedAt

  @@index([organisationId])
}

model Fournisseur {
  id             Int      @id @default(autoincrement())
  nom            String
  telephone      String?
  email          String?
  adresse        String?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  achats         Achat[]

  creeLe         DateTime @default(now())
  modifieLe      DateTime @updatedAt

  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Ventes
// ---------------------------------------------------------------------------

model Vente {
  id              Int           @id @default(autoincrement())
  statut          SaleStatus    @default(COMPLETED)
  modePaiement    PaymentMethod @default(CASH)
  sousTotal       Decimal       @db.Decimal(12, 2)
  remise          Decimal       @db.Decimal(12, 2) @default(0)
  total           Decimal       @db.Decimal(12, 2)
  montantPaye     Decimal       @db.Decimal(12, 2)
  note            String?

  organisationId  Int
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  boutiqueId      Int
  boutique        Boutique     @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  clientId        Int?
  client          Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  vendeurId       Int
  vendeur         Utilisateur  @relation("VenteVendeur", fields: [vendeurId], references: [id])

  lignes          LigneVente[]
  mouvementsStock MouvementStock[]

  creeLe          DateTime  @default(now())
  annuleLe        DateTime?

  @@index([organisationId, boutiqueId, creeLe])
  @@index([clientId])
  // Statistiques de la plateforme (toutes organisations confondues).
  @@index([creeLe])
}

model LigneVente {
  id            Int     @id @default(autoincrement())
  quantite      Int
  prixUnitaire  Decimal @db.Decimal(12, 2)
  coutUnitaire  Decimal @db.Decimal(12, 2)
  sousTotal     Decimal @db.Decimal(12, 2)

  venteId       Int
  vente         Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)

  produitId     Int
  produit       Produit @relation(fields: [produitId], references: [id])

  @@unique([venteId, produitId])
}

// ---------------------------------------------------------------------------
// Achats
// ---------------------------------------------------------------------------

model Achat {
  id              Int            @id @default(autoincrement())
  statut          PurchaseStatus @default(RECEIVED)
  total           Decimal        @db.Decimal(12, 2)
  note            String?

  organisationId  Int
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  boutiqueId      Int
  boutique        Boutique     @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  fournisseurId   Int?
  fournisseur     Fournisseur? @relation(fields: [fournisseurId], references: [id], onDelete: SetNull)

  creeParId       Int
  creePar         Utilisateur  @relation("AchatCreePar", fields: [creeParId], references: [id])

  lignes          LigneAchat[]
  mouvementsStock MouvementStock[]

  creeLe          DateTime @default(now())

  @@index([organisationId, boutiqueId, creeLe])
}

model LigneAchat {
  id            Int     @id @default(autoincrement())
  quantite      Int
  coutUnitaire  Decimal @db.Decimal(12, 2)
  sousTotal     Decimal @db.Decimal(12, 2)

  achatId       Int
  achat         Achat   @relation(fields: [achatId], references: [id], onDelete: Cascade)

  produitId     Int
  produit       Produit @relation(fields: [produitId], references: [id])

  @@unique([achatId, produitId])
}

// ---------------------------------------------------------------------------
// Finances et audit
// ---------------------------------------------------------------------------

model Depense {
  id             Int      @id @default(autoincrement())
  categorie      String
  libelle        String
  montant        Decimal  @db.Decimal(12, 2)
  note           String?
  date           DateTime @default(now())

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  boutiqueId     Int?
  boutique       Boutique? @relation(fields: [boutiqueId], references: [id], onDelete: SetNull)

  creeParId      Int
  creePar        Utilisateur @relation("DepenseCreePar", fields: [creeParId], references: [id])

  creeLe         DateTime @default(now())

  @@index([organisationId, date])
}

/// Journal en ajout seul des actions sensibles, rattaché à une organisation.
model JournalAudit {
  id             Int      @id @default(autoincrement())
  action         String
  entite         String
  entiteId       Int?
  metadonnees    Json?

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  utilisateurId  Int?
  utilisateur    Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  creeLe         DateTime @default(now())

  @@index([organisationId, creeLe])
  @@index([creeLe])
}
